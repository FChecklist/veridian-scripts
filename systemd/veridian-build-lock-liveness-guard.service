#
# UMR-20260806-121640-bee5 (governing UMR-20260806-071025-1d28, folding into
# the already-completed UMR-20260806-120603-217b / pm_decisions_pending row
# 62 / child UMR-20260806-121247-a93a's short-wait+requeue proposal -- this
# unit is COMPLEMENTARY to, not a replacement for, that proposal: this
# guards the LOCK HOLDER's own liveness so a genuinely idle holder is
# released in minutes instead of the full 1800s outer `timeout`; the row-62
# proposal separately addresses WAITERS requeuing instead of blocking for
# their full flock wait).
#
# ExecStart runs build_lock_liveness_guard.py's own `--required-idle-windows
# 2 --window-seconds 90` real production defaults (see that script's module
# docstring for the full real reasoning): a single invocation can therefore
# legitimately run for up to ~3 real minutes while actively confirming a
# hang (plus up to 30s more if it actually kills one) -- Type=oneshot is
# correct here specifically because that is bounded, finite, real work per
# invocation, not a persistent daemon loop.
# =============================================================================
[Unit]
Description=VERIDIAN build-lock holder liveness guard: detect a genuinely whole-tree-idle /tmp/veridian-quality-gate-build.lock holder and release it in minutes, not the full 1800s outer timeout (UMR-20260806-121640-bee5)
ConditionPathExists=!/opt/veridian/ai-os/locks/resource-governor-EMERGENCY_STOP

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/veridian/scripts/build_lock_liveness_guard.py --lock-path /tmp/veridian-quality-gate-build.lock
StandardOutput=append:/opt/veridian/ai-os/logs/build-lock-liveness-guard.log
StandardError=append:/opt/veridian/ai-os/logs/build-lock-liveness-guard.log
