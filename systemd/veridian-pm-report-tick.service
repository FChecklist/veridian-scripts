[Unit]
Description=VERIDIAN PM report v3: real, pure, deterministic PM report generator (UMR-20260805-181636-32f2) -- replaces the AI-reasoned-every-10-minutes generator that contributed to hitting the Owner's weekly Claude Code usage limit
ConditionPathExists=!/opt/veridian/ai-os/locks/resource-governor-EMERGENCY_STOP

[Service]
Type=oneshot
ExecStart=/opt/veridian/scripts/run-logged.sh "pm-report-tick" /usr/bin/python3 /opt/veridian/scripts/generate_pm_report_v3.py
StandardOutput=append:/opt/veridian/ai-os/logs/pm-report-tick-cron.log
StandardError=append:/opt/veridian/ai-os/logs/pm-report-tick-cron.log
